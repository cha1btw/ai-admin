# Copy to .env and fill in. Never commit .env.

ENV=dev
DATABASE_URL=postgresql+asyncpg://ai_admin:ai_admin@localhost:5435/ai_admin

# --- LLM ---------------------------------------------------------------------------------
LLM_PROVIDER=openai
# Pick the model by `make eval` results; the code does not assume a default.
LLM_MODEL=
OPENAI_API_KEY=
# Any OpenAI-compatible API instead of OpenAI (empty = OpenAI). For tests only on free tiers:
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#           LLM_API_KEY=<key from Google AI Studio>, LLM_MODEL=gemini-2.5-flash
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1/ (no key), start it with
#           OLLAMA_CONTEXT_LENGTH=16384 ollama serve (the default 4096 is too small for our prompt)
# The Gemini free tier may use the data to improve Google's products: never with real clients.
LLM_BASE_URL=
LLM_API_KEY=
# Leave empty for models that accept only the default temperature.
LLM_TEMPERATURE=
LLM_TIMEOUT_S=25

# --- Telegram ----------------------------------------------------------------------------
# Owner Bot: notifications and commands for masters; masters also connect it as a business bot.
OWNER_BOT_TOKEN=
# Public demo bot of the demo studio.
DEMO_BOT_TOKEN=
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Founders' Telegram user ids, comma separated: admin commands and alerts.
ADMIN_TELEGRAM_IDS=
# Chat for error alerts (a founder's id or a private group id).
ALERT_CHAT_ID=
# Where demo studio notifications go (optional).
DEMO_OWNER_CHAT_ID=

# --- Meta / Instagram --------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v26.0

# --- Google Calendar ---------------------------------------------------------------------
# Path to the service account JSON key (keep it outside git, e.g. secrets/google.json).
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Security and URLs -------------------------------------------------------------------
# Fernet key for stored tokens: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Public HTTPS address of the API, e.g. https://api.example.com (webhooks, OAuth callback).
PUBLIC_BASE_URL=

# --- Admin panel and landing ---------------------------------------------------------------
# Login: /admin in Owner Bot (founders from ADMIN_TELEGRAM_IDS) or `python -m app.cli admin link`.
ADMIN_SESSION_HOURS=12
# Landing origin allowed to POST /leads, e.g. https://ai-admin.vercel.app
LANDING_ORIGIN=
# Cost estimate in reports: USD per 1M input/output tokens of LLM_MODEL (see the provider's price page).
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=

# --- Tuning ------------------------------------------------------------------------------
DEBOUNCE_SECONDS=4
DEMO_TENANT_SLUG=demo_studio

# --- Production (deploy/docker-compose.prod.yml) ---------------------------------------------
POSTGRES_PASSWORD=
DOMAIN=
# Off-site backups with rclone, e.g. b2:ai-admin-backups
RCLONE_REMOTE=
